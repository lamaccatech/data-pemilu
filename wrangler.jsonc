{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "data-pemilu",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",
    "observability": { "enabled": true },
    // One database per election. The placeholder ids are replaced by `pnpm cf:setup` (see README).
    "d1_databases": [
        {
            "binding": "DB_2024",
            "database_name": "pemilu2024",
            "database_id": "00000000-0000-0000-0000-000000002024",
            "migrations_dir": "migrations/2024"
        },
        {
            "binding": "DB_2019",
            "database_name": "pemilu2019",
            "database_id": "00000000-0000-0000-0000-000000002019",
            "migrations_dir": "migrations/2019"
        }
    ],
    // Finished answers, filled by `pnpm prewarm`. The placeholder ids here are replaced by `pnpm cf:setup`.
    "kv_namespaces": [{ "binding": "CACHE_KV", "id": "00000000000000000000000000002024" }],
    // Boundary files built by `pnpm build-geo`, named <pemilu>/<wilayah>.geojson.
    "r2_buckets": [{ "binding": "GEO", "bucket_name": "data-pemilu-batas" }]
}
